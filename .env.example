# 汇率来源：frankfurter 或 exchangerate-api
RATE_PROVIDER=exchangerate-api

# 仅在使用 ExchangeRate-API 的密钥接口时需要；留空则使用免费开放接口。
EXCHANGERATE_API_KEY=

# 可选：兼容汇率接口的自定义地址。
RATES_URL=

# 直连模式绑定的主机地址；Traefik 模式会移除端口映射。
HOST_BIND_ADDRESS=127.0.0.1
# 直连模式暴露到主机的端口。
HOST_PORT=8088

# 使用 docker-compose.traefik.yml 覆盖文件时设为 1；直连模式设为 0。
TRAEFIK_ENABLED=0
# Traefik 路由匹配的域名。
TRAEFIK_HOST=img.example.com
# Traefik 已连接的 Docker 外部网络名称。
TRAEFIK_NETWORK=frontend
# Traefik entrypoints 名称，多个值用逗号分隔。
TRAEFIK_ENTRYPOINTS=https
# Traefik router 和对应 service 的名称。
TRAEFIK_ROUTER_NAME=vps_cal
# 是否为路由启用 TLS。
TRAEFIK_TLS=true
# Traefik 中已配置的证书解析器名称。
TRAEFIK_CERTRESOLVER=cloudflare
# Traefik router 优先级。
TRAEFIK_PRIORITY=10
# 中间件必须由 Traefik file provider 定义；不使用时请从覆盖文件中移除对应 label。
TRAEFIK_MIDDLEWARES=real-ip@file

# 站点名称和 SEO 元数据。
SITE_NAME=VPS 剩余价值计算器
SITE_DESCRIPTION=计算 VPS 剩余价值和剩余时间，支持多种货币、付款周期及 SVG 分享。
SITE_KEYWORDS=VPS,剩余价值,计算器,续费,汇率

# 站点公开 origin，例如 https://calc.example.com；不要包含路径。
# 用于 canonical 元数据和生成的 SVG 分享链接。
SITE_URL=

# 可选：站点图标 URL 或站内绝对路径，例如 https://example.com/icon.png 或 /assets/icon.png。
# 未设置或图标不可用时会回退到内置 brand-icon.svg。
SITE_ICON_URL=

# 计算统计使用的 SQLite 数据库路径；Docker Compose 默认将数据保存在持久化卷中。
DB_PATH=/data/vps-jsq.db

# 单个客户端 IP 在限流窗口内可调用计算接口的次数。
CALCULATE_RATE_LIMIT=30
# 限流窗口时长，使用 Go duration 格式，例如 30s、1m、5m。
CALCULATE_RATE_WINDOW=1m
