# Select: frankfurter or exchangerate-api
RATE_PROVIDER=exchangerate-api

# Required only for ExchangeRate-API's keyed endpoint; leave blank to use Open Access.
EXCHANGERATE_API_KEY=

# Optional override for a compatible endpoint.
RATES_URL=

# Host port published by Docker Compose.
HOST_PORT=8088

# Site identity and SEO metadata
SITE_NAME=VPS 剩余价值计算器
SITE_DESCRIPTION=计算 VPS 剩余价值和剩余时间，支持多种货币、付款周期及 SVG 分享。
SITE_KEYWORDS=VPS,剩余价值,计算器,续费,汇率

# Public origin, for example https://calc.example.com (no path).
# Used by canonical metadata and generated SVG share links.
SITE_URL=

# Optional absolute URL or site path, e.g. https://example.com/icon.svg or /assets/icon.svg
SITE_ICON_URL=
