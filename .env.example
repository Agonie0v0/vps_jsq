# Select: frankfurter or exchangerate-api
RATE_PROVIDER=exchangerate-api

# Required only for ExchangeRate-API's keyed endpoint; leave blank to use Open Access.
EXCHANGERATE_API_KEY=

# Optional override for a compatible endpoint.
RATES_URL=

# Direct mode publishes this port on the host. Traefik mode removes the port mapping.
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=8088

# Select the Traefik override here to enable Traefik; keep only the base file to disable it.
COMPOSE_FILE=docker-compose.yml
# Keep this in sync with COMPOSE_FILE: set to 1 when the Traefik override is selected.
TRAEFIK_ENABLED=0
TRAEFIK_HOST=img.example.com
TRAEFIK_NETWORK=frontend
TRAEFIK_ENTRYPOINTS=https
TRAEFIK_ROUTER_NAME=vps_cal
TRAEFIK_TLS=true
TRAEFIK_CERTRESOLVER=cloudflare
TRAEFIK_PRIORITY=10
# Middleware must exist in Traefik's file provider. If unused, remove its label from the override file.
TRAEFIK_MIDDLEWARES=real-ip@file

# Site identity and SEO metadata
SITE_NAME=VPS 剩余价值计算器
SITE_DESCRIPTION=计算 VPS 剩余价值和剩余时间，支持多种货币、付款周期及 SVG 分享。
SITE_KEYWORDS=VPS,剩余价值,计算器,续费,汇率

# Public origin, for example https://calc.example.com (no path).
# Used by canonical metadata and generated SVG share links.
SITE_URL=

# Optional absolute URL or site path, e.g. https://example.com/icon.svg or /assets/icon.svg
SITE_ICON_URL=
